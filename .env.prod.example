# Production .env for the Droplet (docker-compose.prod.yml).
# Copy to `.env` on the server and fill in. NEVER commit the real .env.

# ---- Domains (point both A-records at the droplet IP) ----
APP_DOMAIN=app.exemplu.ro
FILES_DOMAIN=files.exemplu.ro

# ---- Core ----
ENVIRONMENT=production
# Generate strong values (see docs). Keep them secret.
SECRET_KEY=CHANGE_ME_long_random_string_min_32_chars
DATA_ENCRYPTION_KEY=CHANGE_ME_any_long_passphrase

# ---- PostgreSQL (used by the db service AND the backend DATABASE_URL) ----
POSTGRES_USER=medai
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=asistent_medical

# ---- Object storage (MinIO) ----
S3_ACCESS_KEY=CHANGE_ME_minio_user
S3_SECRET_KEY=CHANGE_ME_minio_password
S3_BUCKET=medical-documents
S3_REGION=eu-central-1
# S3_ENDPOINT_URL / S3_PUBLIC_URL / S3_USE_SSL are set in docker-compose.prod.yml.

# ---- AI (Groq, free) ----
AI_DEFAULT_PROVIDER=groq
GROQ_API_KEY=gsk_CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile

# ---- CORS / links (same origin as the app) ----
BACKEND_CORS_ORIGINS=https://app.exemplu.ro
FRONTEND_URL=https://app.exemplu.ro

# ---- Google Maps (optional) ----
GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY is a build-time value — see docs to bake it in.

RATE_LIMIT_ENABLED=true

# Durable push notification outbox (real sends require configured FCM)
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_INTERVAL_SECONDS=30

# Hours after recovery/email verification token expiry before hash cleanup.
# Runs in the storage cleanup worker; does not delete clinical/audit records.
RECOVERY_TOKEN_RETENTION_HOURS=24
