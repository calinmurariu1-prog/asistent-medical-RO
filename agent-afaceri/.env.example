# Provider AI: "anthropic" (Claude) sau lasă gol pentru mod demo offline ("mock")
AI_PROVIDER=anthropic

# Cheia Anthropic (fără ea, aplicația rulează în mod demonstrativ offline)
ANTHROPIC_API_KEY=

# Modelul Claude folosit
ANTHROPIC_MODEL=claude-sonnet-5

# Origini permise pentru CORS (frontend). "*" pentru dezvoltare.
CORS_ORIGINS=*

# Secretul pentru semnarea token-urilor JWT (SCHIMBĂ în producție!)
SECRET_KEY=dev-secret-change-me

# Baza de date (implicit SQLite local). Ex Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agent_afaceri
DATABASE_URL=sqlite:///./app.db

# URL-ul backend-ului, folosit de frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
