{
  "name": "asistent-medical-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "tsc --noEmit",
    "build:mobile": "node scripts/build-mobile.mjs",
    "gen:assets": "node scripts/gen-assets.mjs && capacitor-assets generate --android --splashBackgroundColor '#F4F7F6' --splashBackgroundColorDark '#060B19'",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/session.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "framer-motion": "12.43.0",
    "lucide-react": "^0.446.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23"
  }
}
