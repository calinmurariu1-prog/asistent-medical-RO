# ============================================================================
# Asistent Medical AI - Environment configuration (example)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---- General ----
ENVIRONMENT=development                 # development | staging | production
PROJECT_NAME="Asistent Medical AI"
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# AES-256 key for field-level encryption (32 bytes, base64 urlsafe). Generate:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64-key

# ---- Database (PostgreSQL) ----
POSTGRES_USER=medai
POSTGRES_PASSWORD=medai_dev_password
POSTGRES_DB=asistent_medical
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full URL (overrides the parts above if set)
DATABASE_URL=postgresql+psycopg://medai:medai_dev_password@db:5432/asistent_medical

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=medical-documents
S3_REGION=eu-central-1
S3_USE_SSL=false

# ---- AI providers ----
# Default provider used by the AI service: anthropic | openai | gemini
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---- OCR ----
# tesseract must be installed in the backend image (it is, via Dockerfile)
OCR_LANGUAGES=ron+eng

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@asistent-medical.ro
SMTP_TLS=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
